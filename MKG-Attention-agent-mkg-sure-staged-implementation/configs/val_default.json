{
  "run_name": "val_default",
  "run_id": null,
  "split": "val",
  "limit": null,
  "data": {
    "annotations_val": "data/tvqa_plus_annotations_with_test/tvqa_plus_valid_preprocessed.json",
    "annotations_test": "data/tvqa_plus_annotations_with_test/tvqa_plus_test_preprocessed_no_anno.json",
    "subtitles": "data/tvqa_plus_subtitles.json",
    "visual_concepts": "data/det_visual_concepts_hq.pickle"
  },
  "llm": {
    "env_file": ".env",
    "api_key_env": "AIGCBEST_API_KEY",
    "host": "api2.aigcbest.top",
    "path": "/v1/chat/completions",
    "model": "claude-sonnet-4-6-thinking",
    "temperature": 0.0,
    "max_tokens": 1200,
    "timeout_seconds": 60,
    "sleep_seconds": 1.0,
    "max_retries": 3
  },
  "evidence": {
    "include_subtitles": true,
    "include_bbox": true,
    "include_visual_concepts": false,
    "subtitle_window_padding_seconds": 2.0,
    "max_subtitle_turns_per_chunk": 6,
    "max_visual_frames_per_chunk": 5,
    "max_subtitle_chunks_per_question": 8
  },
  "retrieval": {
    "max_seed_edges": 12,
    "max_graph_edges": 20,
    "max_selected_evidence_units": 5,
    "expansion_hops": 1,
    "node_degree_cap": 8,
    "dense_model_name": "sentence-transformers/all-MiniLM-L6-v2",
    "weight_dense": 0.35,
    "weight_lexical": 0.2,
    "weight_provenance": 0.15,
    "weight_confidence": 0.15,
    "weight_subtitle_prior": 0.15
  },
  "audit": {
    "enabled": true,
    "quality_threshold": 0.55,
    "low_score_threshold": 0.2,
    "low_confidence_threshold": 0.55,
    "patch_budget": 3
  },
  "answering": {
    "max_subtitle_context_units": 3,
    "max_graph_evidence_units": 5,
    "prefer_subtitles_for_reasoning": true,
    "verify_if_audit_below": 0.5,
    "verify_if_confidence_below": 0.55,
    "verify_on_stream_disagreement": true,
    "verify_on_bbox_only_reasoning": true,
    "require_json_answer": true
  },
  "prompts": {
    "triplet_text": "prompts/triplet_text_prompt.txt",
    "triplet_visual": "prompts/triplet_visual_prompt.txt",
    "answer_mc": "prompts/answer_multiple_choice_prompt.txt",
    "verify_answer": "prompts/verify_answer_prompt.txt"
  }
}
